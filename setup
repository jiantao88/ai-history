#!/usr/bin/env bash
set -euo pipefail

# ai-history installer
# Downloads pre-built binary from GitHub Releases and installs skills.
# No Rust or build tools required.
#
# Usage:
#   curl -fsSL https://raw.githubusercontent.com/jiantao88/ai-history/master/setup | bash
#   ./setup [--claude-only | --codex-only]

REPO="jiantao88/ai-history"
BINARY_NAME="ai-history"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

info()  { echo -e "${BLUE}[info]${NC} $1"; }
ok()    { echo -e "${GREEN}[ok]${NC} $1"; }
warn()  { echo -e "${YELLOW}[warn]${NC} $1"; }
err()   { echo -e "${RED}[error]${NC} $1" >&2; }

INSTALL_CLAUDE=true
INSTALL_CODEX=true
if [[ "${1:-}" == "--claude-only" ]]; then
    INSTALL_CODEX=false
elif [[ "${1:-}" == "--codex-only" ]]; then
    INSTALL_CLAUDE=false
fi

# ─────────────────────────────────────────────
# Detect platform
# ─────────────────────────────────────────────
detect_target() {
    local os arch
    os="$(uname -s)"
    arch="$(uname -m)"

    case "$os" in
        Darwin) os="apple-darwin" ;;
        Linux)  os="unknown-linux-gnu" ;;
        *)      err "Unsupported OS: $os"; exit 1 ;;
    esac

    case "$arch" in
        x86_64|amd64)   arch="x86_64" ;;
        aarch64|arm64)  arch="aarch64" ;;
        *)              err "Unsupported architecture: $arch"; exit 1 ;;
    esac

    echo "${arch}-${os}"
}

# ─────────────────────────────────────────────
# Find install directory
# ─────────────────────────────────────────────
find_install_dir() {
    if [[ -d "$HOME/.cargo/bin" ]]; then
        echo "$HOME/.cargo/bin"
    elif [[ -d "$HOME/.local/bin" ]]; then
        echo "$HOME/.local/bin"
    else
        mkdir -p "$HOME/.local/bin"
        echo "$HOME/.local/bin"
    fi
}

# ─────────────────────────────────────────────
# Step 1: Download and install binary
# ─────────────────────────────────────────────
TARGET="$(detect_target)"
INSTALL_DIR="$(find_install_dir)"

info "Detected platform: $TARGET"
info "Install directory: $INSTALL_DIR"

# Get latest release tag
info "Fetching latest release..."
LATEST_TAG=$(curl -fsSL "https://api.github.com/repos/$REPO/releases/latest" 2>/dev/null | grep '"tag_name"' | head -1 | sed 's/.*"tag_name": *"\([^"]*\)".*/\1/')

if [[ -n "$LATEST_TAG" ]]; then
    ARCHIVE_URL="https://github.com/$REPO/releases/download/$LATEST_TAG/$BINARY_NAME-$LATEST_TAG-$TARGET.tar.gz"
    info "Downloading $BINARY_NAME $LATEST_TAG for $TARGET..."

    TMPDIR=$(mktemp -d)
    trap 'rm -rf "$TMPDIR"' EXIT

    if curl -fsSL "$ARCHIVE_URL" -o "$TMPDIR/archive.tar.gz" 2>/dev/null; then
        tar -xzf "$TMPDIR/archive.tar.gz" -C "$TMPDIR"
        mv "$TMPDIR/$BINARY_NAME" "$INSTALL_DIR/$BINARY_NAME"
        chmod +x "$INSTALL_DIR/$BINARY_NAME"
        ok "Binary installed: $INSTALL_DIR/$BINARY_NAME ($LATEST_TAG)"
    else
        warn "Pre-built binary not available for $TARGET"
        # Fallback to cargo install
        if command -v cargo &>/dev/null; then
            info "Falling back to cargo install..."
            CLONE_DIR=$(mktemp -d)
            trap 'rm -rf "$TMPDIR" "$CLONE_DIR"' EXIT
            git clone --depth 1 "https://github.com/$REPO.git" "$CLONE_DIR" 2>/dev/null
            cargo install --path "$CLONE_DIR" --force --quiet 2>/dev/null || cargo install --path "$CLONE_DIR" --force
            ok "Binary installed via cargo"
        else
            err "Download failed and Rust is not installed."
            err "Please install Rust first: curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh"
            exit 1
        fi
    fi
else
    warn "No GitHub release found"
    if command -v cargo &>/dev/null; then
        info "Falling back to cargo install..."
        CLONE_DIR=$(mktemp -d)
        trap 'rm -rf "$CLONE_DIR"' EXIT
        git clone --depth 1 "https://github.com/$REPO.git" "$CLONE_DIR" 2>/dev/null
        cargo install --path "$CLONE_DIR" --force --quiet 2>/dev/null || cargo install --path "$CLONE_DIR" --force
        ok "Binary installed via cargo"
    else
        err "No release available and Rust is not installed."
        err "Please install Rust first: curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh"
        exit 1
    fi
fi

# Ensure install dir is in PATH
case ":$PATH:" in
    *":$INSTALL_DIR:"*) ;;
    *)
        warn "$INSTALL_DIR is not in your PATH"
        warn "Add this to your shell profile: export PATH=\"$INSTALL_DIR:\$PATH\""
        ;;
esac

# ─────────────────────────────────────────────
# Step 2: Install skill files
# ─────────────────────────────────────────────

# Determine where to get skill files from
SKILL_SOURCE=""
if [[ -f "$(dirname "$0")/skills/claude/SKILL.md" ]] 2>/dev/null; then
    SKILL_SOURCE="$(cd "$(dirname "$0")" && pwd)/skills"
else
    # Download from repo
    SKILL_TMPDIR=$(mktemp -d)
    trap 'rm -rf "${TMPDIR:-}" "${CLONE_DIR:-}" "$SKILL_TMPDIR"' EXIT
    info "Downloading skill files..."
    curl -fsSL "https://raw.githubusercontent.com/$REPO/master/skills/claude/SKILL.md" -o "$SKILL_TMPDIR/claude_skill.md" 2>/dev/null || true
    curl -fsSL "https://raw.githubusercontent.com/$REPO/master/skills/codex/SKILL.md" -o "$SKILL_TMPDIR/codex_skill.md" 2>/dev/null || true
    SKILL_SOURCE="$SKILL_TMPDIR"
fi

# Claude Code skill
if [[ "$INSTALL_CLAUDE" == true ]]; then
    CLAUDE_SKILL_DIR="$HOME/.claude/skills/$BINARY_NAME"
    mkdir -p "$CLAUDE_SKILL_DIR"
    if [[ -f "$SKILL_SOURCE/claude/SKILL.md" ]]; then
        cp "$SKILL_SOURCE/claude/SKILL.md" "$CLAUDE_SKILL_DIR/SKILL.md"
    elif [[ -f "$SKILL_SOURCE/claude_skill.md" ]]; then
        cp "$SKILL_SOURCE/claude_skill.md" "$CLAUDE_SKILL_DIR/SKILL.md"
    fi

    if [[ -f "$CLAUDE_SKILL_DIR/SKILL.md" ]]; then
        ok "Claude Code skill installed"

        # Add routing to CLAUDE.md
        CLAUDE_MD="$HOME/.claude/CLAUDE.md"
        if [[ -f "$CLAUDE_MD" ]]; then
            if ! grep -q "ai-history" "$CLAUDE_MD"; then
                printf '\n# ai-history\n- **ai-history** (`~/.claude/skills/ai-history/SKILL.md`) - search/browse AI chat history. Trigger: `/ai-history`\nWhen the user types `/ai-history`, invoke the Skill tool with `skill: "ai-history"` before doing anything else.\n' >> "$CLAUDE_MD"
                ok "Added routing to ~/.claude/CLAUDE.md"
            else
                ok "Routing already exists in ~/.claude/CLAUDE.md"
            fi
        else
            mkdir -p "$HOME/.claude"
            printf '# ai-history\n- **ai-history** (`~/.claude/skills/ai-history/SKILL.md`) - search/browse AI chat history. Trigger: `/ai-history`\nWhen the user types `/ai-history`, invoke the Skill tool with `skill: "ai-history"` before doing anything else.\n' > "$CLAUDE_MD"
            ok "Created ~/.claude/CLAUDE.md with routing"
        fi
    fi
fi

# Codex CLI skill
if [[ "$INSTALL_CODEX" == true ]]; then
    if [[ -d "$HOME/.codex" ]]; then
        CODEX_SKILL_DIR="$HOME/.codex/skills/$BINARY_NAME"
        mkdir -p "$CODEX_SKILL_DIR"
        if [[ -f "$SKILL_SOURCE/codex/SKILL.md" ]]; then
            cp "$SKILL_SOURCE/codex/SKILL.md" "$CODEX_SKILL_DIR/SKILL.md"
        elif [[ -f "$SKILL_SOURCE/codex_skill.md" ]]; then
            cp "$SKILL_SOURCE/codex_skill.md" "$CODEX_SKILL_DIR/SKILL.md"
        fi

        if [[ -f "$CODEX_SKILL_DIR/SKILL.md" ]]; then
            ok "Codex CLI skill installed"
        fi
    else
        warn "Codex CLI not detected (~/.codex not found), skipping"
    fi
fi

# ─────────────────────────────────────────────
# Done
# ─────────────────────────────────────────────
echo ""
echo -e "${GREEN}════════════════════════════════════════${NC}"
echo -e "${GREEN}  ai-history installed successfully!${NC}"
echo -e "${GREEN}════════════════════════════════════════${NC}"
echo ""
echo "  Usage:"
echo "    ai-history list                    # list all projects"
echo "    ai-history search \"keyword\"        # search chat history"
echo "    ai-history export <id> --format prompt  # export for context"
echo ""
if [[ "$INSTALL_CLAUDE" == true ]]; then
    echo "  Claude Code:  type /ai-history in any session"
fi
if [[ "$INSTALL_CODEX" == true && -d "$HOME/.codex" ]]; then
    echo "  Codex CLI:    type /ai-history in any session"
fi
echo ""
