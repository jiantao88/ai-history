#!/usr/bin/env bash
set -euo pipefail

# ai-history installer
# Installs the ai-history CLI binary and skills for Claude Code and/or Codex CLI.
# Usage: ./setup [--claude-only | --codex-only]

REPO_DIR="$(cd "$(dirname "$0")" && pwd)"
SKILL_NAME="ai-history"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

info()  { echo -e "${BLUE}[info]${NC} $1"; }
ok()    { echo -e "${GREEN}[ok]${NC} $1"; }
warn()  { echo -e "${YELLOW}[warn]${NC} $1"; }
err()   { echo -e "${RED}[error]${NC} $1"; }

# Parse args
INSTALL_CLAUDE=true
INSTALL_CODEX=true
if [[ "${1:-}" == "--claude-only" ]]; then
    INSTALL_CODEX=false
elif [[ "${1:-}" == "--codex-only" ]]; then
    INSTALL_CLAUDE=false
fi

# ─────────────────────────────────────────────
# Step 1: Build and install the binary
# ─────────────────────────────────────────────
info "Building ai-history binary..."

if ! command -v cargo &>/dev/null; then
    err "Rust toolchain not found. Installing via rustup..."
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
    source "$HOME/.cargo/env"
fi

cd "$REPO_DIR"
cargo install --path . --force --quiet 2>/dev/null || cargo install --path . --force

if command -v ai-history &>/dev/null; then
    ok "Binary installed: $(which ai-history)"
else
    ok "Binary installed to ~/.cargo/bin/ai-history"
    warn "Add ~/.cargo/bin to your PATH if not already done"
fi

# ─────────────────────────────────────────────
# Step 2: Install Claude Code skill
# ─────────────────────────────────────────────
if [[ "$INSTALL_CLAUDE" == true ]]; then
    CLAUDE_SKILL_DIR="$HOME/.claude/skills/$SKILL_NAME"
    info "Installing Claude Code skill to $CLAUDE_SKILL_DIR..."
    mkdir -p "$CLAUDE_SKILL_DIR"
    cp "$REPO_DIR/skills/claude/SKILL.md" "$CLAUDE_SKILL_DIR/SKILL.md"
    ok "Claude Code skill installed"

    # Add routing to CLAUDE.md if not present
    CLAUDE_MD="$HOME/.claude/CLAUDE.md"
    if [[ -f "$CLAUDE_MD" ]]; then
        if ! grep -q "ai-history" "$CLAUDE_MD"; then
            echo "" >> "$CLAUDE_MD"
            echo "# ai-history" >> "$CLAUDE_MD"
            echo '- **ai-history** (`~/.claude/skills/ai-history/SKILL.md`) - search/browse AI chat history across providers. Trigger: `/ai-history`' >> "$CLAUDE_MD"
            echo 'When the user types `/ai-history`, invoke the Skill tool with `skill: "ai-history"` before doing anything else.' >> "$CLAUDE_MD"
            ok "Added routing to ~/.claude/CLAUDE.md"
        else
            ok "Routing already exists in ~/.claude/CLAUDE.md"
        fi
    else
        mkdir -p "$HOME/.claude"
        cat > "$CLAUDE_MD" << 'EOF'
# ai-history
- **ai-history** (`~/.claude/skills/ai-history/SKILL.md`) - search/browse AI chat history across providers. Trigger: `/ai-history`
When the user types `/ai-history`, invoke the Skill tool with `skill: "ai-history"` before doing anything else.
EOF
        ok "Created ~/.claude/CLAUDE.md with routing"
    fi
fi

# ─────────────────────────────────────────────
# Step 3: Install Codex CLI skill
# ─────────────────────────────────────────────
if [[ "$INSTALL_CODEX" == true ]]; then
    CODEX_SKILL_DIR="$HOME/.codex/skills/$SKILL_NAME"
    if [[ -d "$HOME/.codex" ]]; then
        info "Installing Codex CLI skill to $CODEX_SKILL_DIR..."
        mkdir -p "$CODEX_SKILL_DIR"
        cp "$REPO_DIR/skills/codex/SKILL.md" "$CODEX_SKILL_DIR/SKILL.md"
        ok "Codex CLI skill installed"
    else
        warn "Codex CLI not detected (~/.codex not found), skipping Codex skill"
    fi
fi

# ─────────────────────────────────────────────
# Done
# ─────────────────────────────────────────────
echo ""
echo -e "${GREEN}════════════════════════════════════════${NC}"
echo -e "${GREEN}  ai-history installed successfully!${NC}"
echo -e "${GREEN}════════════════════════════════════════${NC}"
echo ""
echo "  Usage:"
echo "    ai-history list                    # list all projects"
echo "    ai-history search \"keyword\"        # search chat history"
echo "    ai-history export <id> --format prompt  # export for context injection"
echo ""
if [[ "$INSTALL_CLAUDE" == true ]]; then
    echo "  Claude Code:  /ai-history"
fi
if [[ "$INSTALL_CODEX" == true && -d "$HOME/.codex" ]]; then
    echo "  Codex CLI:    /ai-history"
fi
echo ""
